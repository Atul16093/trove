# --- server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- database (Postgres) ---
# Option A — one connection string, for managed Postgres (Supabase, Neon, RDS…).
# When DATABASE_URL is set it wins and the discrete DB_* vars below are ignored.
# e.g. postgresql://user:password@host:5432/trove
DATABASE_URL=
# Migrations connect through DIRECT_URL when set, falling back to DATABASE_URL.
# Point this at the direct (non-pooled) endpoint: transaction-mode poolers such
# as pgbouncer can't hold the session-level locks that DDL needs.
DIRECT_URL=
# true for hosted Postgres that requires TLS — applies
# ssl: { rejectUnauthorized: false } to whichever connection is used.
DB_SSL=false

# Option B — discrete vars, used only when DATABASE_URL is empty (local dev).
DB_HOST=localhost
DB_PORT=5432
DB_USER=trove
DB_PASSWORD=trove
DB_NAME=trove

# Schema every table lives in. Applies to both queries and migrations.
DB_SCHEMA=data

# --- auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# --- telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourTroveBot
# Only ONE process may poll a bot token — Telegram 409s the rest.
# Set to "off" locally when the deployed backend owns the bot (or use a separate dev bot).
TELEGRAM_MODE=polling

# --- enrichment (AI categorizer) ---
# Any provider below produces the same {category, summary, tags} JSON. If no key is
# set — or the call fails, rate-limits, or times out — a keyword fallback runs and the
# app still works end-to-end. Enrichment is never load-bearing.
#
# AI_PROVIDER: anthropic | gemini | groq | openrouter   (default: anthropic)
#   anthropic  — paid. Key: console.anthropic.com. Default model: claude-sonnet-4-6
#   gemini     — generous free tier. Key: aistudio.google.com/apikey
#                Default model: gemini-2.0-flash (also try gemini-2.5-flash)
#   groq       — free tier, very fast, OpenAI-compatible. Key: console.groq.com/keys
#                Default model: llama-3.3-70b-versatile
#   openrouter — one key, many models; ":free" suffixed models cost nothing.
#                Key: openrouter.ai/keys
#                Default model: meta-llama/llama-3.3-70b-instruct:free
AI_PROVIDER=gemini
AI_API_KEY=
# Optional — overrides the provider default above.
AI_MODEL=gemini-2.0-flash
# Optional — point at a proxy or gateway instead of the provider's own host.
AI_BASE_URL=

# Legacy Anthropic vars. Still honoured when AI_API_KEY is unset, so existing
# deploys keep working untouched. Prefer AI_* for anything new.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Instagram oEmbed (optional) ---
# A Facebook app access token ("<app-id>|<app-secret>") unlocks real captions and
# thumbnails for Instagram links via graph.facebook.com/instagram_oembed.
# Leave empty: Instagram links then fall back to the generic OG fetch, which
# Instagram usually answers with a login wall — the item still saves and sorts.
INSTAGRAM_OEMBED_TOKEN=
# Alias, checked if INSTAGRAM_OEMBED_TOKEN is unset.
FACEBOOK_APP_TOKEN=

# --- file storage (local disk for dev) ---
STORAGE_DIR=./storage
