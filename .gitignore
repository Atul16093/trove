# --- dependencies ---
node_modules/
.pnp/
.pnp.js
.yarn/

# --- environment / secrets ---
# Ignore every real env file, at the root and in backend/ and frontend/.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets.json

# --- build output ---
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts.timestamp

# --- runtime / user data ---
# Anchored with a leading slash on purpose. A bare `storage/` matches a
# directory of that name at ANY depth, which also catches the source folder
# backend/src/modules/storage/ — that is how storage.service.ts got left out of
# the repo and broke the Railway build. Only the real runtime dirs belong here;
# nothing under backend/src/ or frontend/ can ever match these.
/backend/storage/
/backend/uploads/
/backend/tmp/
/storage/
/uploads/
/tmp/

# --- logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- test / coverage ---
coverage/
.nyc_output/

# --- editor & OS ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
